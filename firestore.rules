// Regras de segurança do Firestore para o RiskBook.
// Cola isto em: Firebase Console → Firestore Database → Rules → Publish.
//
// Cada utilizador só consegue ler e escrever DENTRO da sua própria pasta
// (users/{o seu uid}). Não há leitura pública, nem acesso cruzado entre contas.
// É isto que protege os dados — a chave de API no HTML é pública por design.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tudo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
