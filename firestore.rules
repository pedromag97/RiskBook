// Regras de segurança do Firestore para o RiskBook.
// Cola isto em: Firebase Console → Firestore Database → separador Rules → Publish.
//
// Cada utilizador só lê e escreve DENTRO da sua própria pasta (users/{o seu uid}).
// Tudo o que não é explicitamente permitido aqui fica negado por omissão — não é
// preciso escrever um bloco a negar o resto.
//
// É isto que protege os dados. A chave de API no HTML é pública por design.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
